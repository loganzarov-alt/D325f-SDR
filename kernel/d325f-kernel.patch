--- a/arch/arm/mach-msm/pil-msa.c
+++ b/arch/arm/mach-msm/pil-msa.c
@@ -20,6 +20,7 @@
 #include <linux/err.h>
 #include <linux/regulator/consumer.h>
 #include <linux/dma-mapping.h>
+#include <mach/scm.h>
 
 #include "peripheral-loader.h"
 #include "pil-q6v5.h"
@@ -57,6 +58,108 @@
 #define STATUS_META_DATA_AUTH_SUCCESS	0x3
 #define STATUS_AUTH_COMPLETE		0x4
 
+/*
+ * The D325 IQ ring lives in a DT-reserved HLOS range below the signed MSS
+ * image.  Keep the modem ELF/authentication range untouched and ask TZ to
+ * share only that reserved range with MSS after MBA authentication succeeds.
+ */
+#define D325_IQ_RING_PHYS		0x05000000
+#define D325_IQ_RING_SIZE		0x04000000
+#define D325_SCM_MP_ASSIGN		0x16
+#define D325_VMID_HLOS			0x3
+#define D325_VMID_MSS_MSA		0xf
+#define D325_PERM_RW			0x6
+
+struct d325_scm_mem_map_info {
+	__le64 mem_addr;
+	__le64 mem_size;
+};
+
+struct d325_scm_perm_info {
+	__le32 vmid;
+	__le32 perm;
+	__le64 ctx;
+	__le32 ctx_size;
+	__le32 unused;
+};
+
+struct d325_scm_assign_req {
+	u32 mem_region;
+	u32 mem_region_size;
+	u32 source;
+	u32 source_size;
+	u32 destination;
+	u32 destination_size;
+	u32 spare;
+};
+
+static int d325_share_iq_ring_with_mss(struct pil_desc *pil)
+{
+	static bool assigned;
+	struct d325_scm_mem_map_info *map;
+	struct d325_scm_perm_info *dest;
+	struct d325_scm_assign_req request;
+	dma_addr_t dma;
+	u8 *buf;
+	u32 *source;
+	u32 scm_ret = 0;
+	int available;
+	int ret;
+
+	if (assigned)
+		return 0;
+
+	available = scm_is_call_available(SCM_SVC_MP, D325_SCM_MP_ASSIGN);
+	if (available <= 0) {
+		dev_err(pil->dev, "D325 IQ assign_mem unavailable: %d\n",
+			available);
+		return 0;
+	}
+
+	/* Three independently 64-byte-aligned SCM arrays. */
+	buf = dma_alloc_coherent(pil->dev, 192, &dma, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	memset(buf, 0, 192);
+
+	source = (u32 *)(buf + 0);
+	map = (struct d325_scm_mem_map_info *)(buf + 64);
+	dest = (struct d325_scm_perm_info *)(buf + 128);
+
+	source[0] = cpu_to_le32(D325_VMID_HLOS);
+	map->mem_addr = cpu_to_le64(D325_IQ_RING_PHYS);
+	map->mem_size = cpu_to_le64(D325_IQ_RING_SIZE);
+	dest[0].vmid = cpu_to_le32(D325_VMID_HLOS);
+	dest[0].perm = cpu_to_le32(D325_PERM_RW);
+	dest[1].vmid = cpu_to_le32(D325_VMID_MSS_MSA);
+	dest[1].perm = cpu_to_le32(D325_PERM_RW);
+
+	request.mem_region = (u32)(dma + 64);
+	request.mem_region_size = sizeof(*map);
+	request.source = (u32)dma;
+	request.source_size = sizeof(*source);
+	request.destination = (u32)(dma + 128);
+	request.destination_size = 2 * sizeof(*dest);
+	request.spare = 0;
+
+	ret = scm_call(SCM_SVC_MP, D325_SCM_MP_ASSIGN, &request,
+		       sizeof(request), &scm_ret, sizeof(scm_ret));
+	dma_free_coherent(pil->dev, 192, buf, dma);
+
+	if (ret || scm_ret) {
+		dev_err(pil->dev,
+			"D325 IQ assign_mem failed: call=%d secure=%u\n",
+			ret, scm_ret);
+		return 0;
+	}
+
+	assigned = true;
+	dev_info(pil->dev,
+		 "D325 IQ ring shared HLOS+MSS: 0x%08x+0x%08x\n",
+		 D325_IQ_RING_PHYS, D325_IQ_RING_SIZE);
+	return 0;
+}
+
 /* External BHS */
 #define EXTERNAL_BHS_ON			BIT(0)
 #define EXTERNAL_BHS_STATUS		BIT(4)
@@ -374,6 +477,8 @@
 		dev_err(pil->dev, "MBA returned error %d for image\n", status);
 		ret = -EINVAL;
 	}
+	if (!ret)
+		d325_share_iq_ring_with_mss(pil);
 
 	return ret;
 }
